#!/bin/sh
#
# initramfs hook for the CardputerZero first-boot resize.
#
# The resize_early script runs resize2fs on the raw root partition before the
# root filesystem is mounted, so resize2fs and its shared libraries must be
# present in the initramfs.  timeout is usually already provided by
# initramfs-tools, but copy it explicitly so the script does not depend on the
# initramfs flavour.

PREREQ=""

prereqs () {
  echo "${PREREQ}"
}

case "${1}" in
  prereqs)
    prereqs
    exit 0
    ;;
esac

. /usr/share/initramfs-tools/hook-functions

copy_exec /usr/sbin/resize2fs /usr/sbin
rc=$?
# copy_exec returns 1 when the target already exists, which is fine.  Anything
# greater is a real copy error and must fail the initramfs build.
if [ "$rc" -gt 1 ]; then
  exit "$rc"
fi

# timeout is best-effort: the initramfs usually already has a working one.
copy_exec /usr/bin/timeout /usr/bin || true

exit 0
