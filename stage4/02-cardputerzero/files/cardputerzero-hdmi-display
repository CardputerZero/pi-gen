#!/bin/sh
set -eu

SYSTEMCTL=${CARDPUTERZERO_SYSTEMCTL:-/usr/bin/systemctl}
LIGHTDM_SERVICE=${CARDPUTERZERO_LIGHTDM_SERVICE:-lightdm.service}
OOBE_MARKER=${CARDPUTERZERO_OOBE_MARKER:-/var/lib/LaunchWizard/run-oobe}
STATUS_FILE=${CARDPUTERZERO_HDMI_STATUS_FILE:-}
POLL_INTERVAL=${CARDPUTERZERO_HDMI_POLL_INTERVAL:-2}
RECONCILE_POLLS=${CARDPUTERZERO_HDMI_RECONCILE_POLLS:-30}

find_status_file()
{
    status_file=$STATUS_FILE
    if [ -n "$STATUS_FILE" ]; then
        return
    fi

    status_file=
    for candidate in /sys/class/drm/card*-HDMI-A-1/status; do
        if [ -r "$candidate" ]; then
            status_file=$candidate
            return
        fi
    done
}

stop_desktop()
{
    if "$SYSTEMCTL" is-active --quiet "$LIGHTDM_SERVICE"; then
        "$SYSTEMCTL" --no-block stop "$LIGHTDM_SERVICE"
    fi
}

start_desktop()
{
    if ! "$SYSTEMCTL" is-active --quiet "$LIGHTDM_SERVICE"; then
        "$SYSTEMCTL" --no-block start "$LIGHTDM_SERVICE"
    fi
}

desired_state()
{
    state=stopped
    if [ -e "$OOBE_MARKER" ]; then
        return
    fi

    find_status_file
    if [ -z "$status_file" ] || [ ! -r "$status_file" ]; then
        return
    fi

    status=missing
    IFS= read -r status <"$status_file" || true
    connector_dir=${status_file%/status}
    if [ "$status" = connected ] && [ -s "$connector_dir/modes" ]; then
        state=started
    fi
}

apply_state()
{
    if [ "$1" = started ]; then
        start_desktop
    else
        stop_desktop
    fi
}

if [ "${1:-}" = --once ]; then
    desired_state
    apply_state "$state"
    exit 0
fi

last_state=
polls=0
while :; do
    desired_state
    polls=$((polls + 1))
    if [ "$state" != "$last_state" ] || [ "$polls" -ge "$RECONCILE_POLLS" ]; then
        apply_state "$state"
        last_state=$state
        polls=0
    fi
    sleep "$POLL_INTERVAL"
done
